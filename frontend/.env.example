# Frontend Environment Variables Template
# Copy this file to .env.local (for development) or .env.production (for Azure VM)

# ===================================
# 🔌 API CONFIGURATION
# ===================================
# Backend API base URL
VITE_API_BASE_URL=http://localhost:3001/api

# File server URL (for uploads, images, certificates)
VITE_FILE_SERVER_URL=http://localhost:3001

# For production on Azure VM, use your actual domains:
# VITE_API_BASE_URL=https://api.fairuzfd.site/api
# VITE_FILE_SERVER_URL=https://api.fairuzfd.site

# ===================================
# 📧 EMAILJS CONFIGURATION
# ===================================
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ===================================
# 🔐 SECURITY CONFIGURATION
# ===================================
VITE_BCRYPT_SALT_ROUNDS=12
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_SESSION_TIMEOUT=3600000

# ===================================
# 🎨 APP CONFIGURATION
# ===================================
VITE_APP_NAME=PERGUNU Scholarship System

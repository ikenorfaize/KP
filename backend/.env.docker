# ===== DOCKER ENVIRONMENT CONFIGURATION =====
# This file is used when running with Docker Compose

# ===== APPLICATION ENVIRONMENT =====
NODE_ENV=production

# ===== API CONFIGURATION =====
PORT=3001
FILE_PORT=3002

# ===== CORS SECURITY =====
# ⚠️ CRITICAL: Update these with your actual Azure VM domains
ALLOWED_ORIGINS=https://fairuzfd.site,https://www.fairuzfd.site,https://api.fairuzfd.site
FRONTEND_URL=https://fairuzfd.site

# ===== SECURITY CONFIGURATION =====
VITE_BCRYPT_SALT_ROUNDS=12

# ===== DATA STORAGE CONFIGURATION =====
# Path to JSON database file (set in docker-compose.yml volume mount)
DB_PATH=/app/data/db.json

# ===== CLOUDINARY CONFIGURATION =====
# ⚠️ Uncomment and fill in your Cloudinary credentials for production
# Get credentials from: https://cloudinary.com/console
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ===== DEPLOYMENT NOTES =====
# - These values are loaded by backend service in docker-compose.yml
# - Update ALLOWED_ORIGINS and FRONTEND_URL to match your actual domains
# - Never commit sensitive credentials to Git
# - Use Docker secrets or Azure Key Vault for production secrets
